{
	"name": "mes-tours",
	"private": true,
	"type": "module",
	"homepage": "https://dezande.github.io/mes-tours/",
	"engines": {
		"node": ">=26 <27"
	},
	"scripts": {
		"dev": "vite",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "vite build && tsc -p src/sw && node outils/check-dist.ts && node outils/stamp-build.ts",
		"typecheck": "tsc -p src --noEmit && tsc -p src/sw --noEmit && tsc",
		"test": "jest --selectProjects unitaires composants",
		"test:cibles": "node outils/tests-cibles.ts",
		"check:changelog": "node outils/check-changelog.ts",
		"test:e2e": "jest --selectProjects e2e --runInBand --forceExit",
		"serve": "npm run build && node outils/serve.ts",
		"deploy": "node outils/deploy.ts"
	},
	"devDependencies": {
		"@jest/globals": "^30.5.2",
		"@preact/preset-vite": "^2.10.6",
		"@swc/core": "^1.16.18",
		"@swc/jest": "^0.2.39",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/preact": "^3.2.4",
		"@testing-library/user-event": "^14.6.8",
		"@types/jest": "^30.0.0",
		"@types/jest-expect-message": "^1.0.4",
		"@types/node": "^26.6.5",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jest-expect-message": "^1.1.3",
		"sass": "^1.105.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"preact": "^11.0.1"
	}
}
